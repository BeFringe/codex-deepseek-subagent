+async fn exact_g4_qualification_role_rejects_allowlisted_external_name_spoofs() {
+    let plan = probe_with(
+        |turn| {
+            update_turn_settings_for_test(turn, |settings| {
+                Arc::make_mut(&mut settings.model_info).apply_patch_tool_type = None;
+            });
+            update_config(turn, |config| {
+                config.multi_agent_v2.tool_namespace = Some("g4_assignment".to_string());
+            });
+            turn.session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id: ThreadId::new(),
+                depth: 1,
+                agent_path: Some(AgentPath::try_from("/root/g4_spoof").expect("valid agent path")),
+                agent_nickname: None,
+                agent_role: Some("g4_qualification_probe_worker".to_string()),
+            });
+        },
+        ToolPlanInputs {
+            extension_tool_executors: vec![
+                Arc::new(TestNamespaceExtensionTool {
+                    namespace: "functions",
+                    tool_name: "apply_patch",
+                }),
+                Arc::new(TestNamespaceExtensionTool {
+                    namespace: "g4_assignment",
+                    tool_name: "list_agents",
+                }),
+            ],
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await;
+
+    plan.assert_registered_lacks(&[
+        "apply_patch",
+        &ToolName::namespaced("g4_assignment", "list_agents").to_string(),
+    ]);
+    plan.assert_visible_lacks(&["functions", "g4_assignment"]);
+    assert_eq!(
+        plan.qualification_catalog["registered_tools"],
+        json!([{"namespace": null, "name": "view_image"}])
+    );
+}
+
+#[tokio::test]
+async fn exact_g4_qualification_parent_rejects_allowlisted_external_name_spoofs() {
+    let plan = probe_with(
+        |turn| {
+            update_turn_settings_for_test(turn, |settings| {
+                Arc::make_mut(&mut settings.model_info).apply_patch_tool_type = None;
+            });
+            update_config(turn, |config| {
+                config.multi_agent_v2.tool_namespace = Some("g4_assignment".to_string());
+            });
+            turn.session_source = SessionSource::Custom("g4_qualification_parent_test".to_string());
+        },
+        ToolPlanInputs {
+            extension_tool_executors: vec![
+                Arc::new(TestNamespaceExtensionTool {
+                    namespace: "functions",
+                    tool_name: "apply_patch",
+                }),
+                Arc::new(TestNamespaceExtensionTool {
+                    namespace: "g4_assignment",
+                    tool_name: "spawn_agent",
+                }),
+            ],
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await;
+
+    plan.assert_registered_lacks(&[
+        "apply_patch",
+        &ToolName::namespaced("g4_assignment", "spawn_agent").to_string(),
+    ]);
+    let registered_tools = plan.qualification_catalog["registered_tools"]
+        .as_array()
+        .expect("registered tools should be an array");
+    assert!(
+        registered_tools
+            .iter()
+            .all(|entry| { entry["name"] != "apply_patch" && entry["name"] != "spawn_agent" })
+    );
+}
