+#[tokio::test]
+async fn multi_agent_v2_close_agent_claims_only_exact_closed_catalog_actor_quiescence() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    let manager = thread_manager();
+    let mut config = (*turn.config).clone();
+    config
+        .features
+        .enable(Feature::MultiAgentV2)
+        .expect("test config should allow feature update");
+    config.agent_roles.insert(
+        "g4_qualification_probe_worker".to_string(),
+        AgentRoleConfig {
+            description: Some("Exact G4 qualification role".to_string()),
+            config_file: None,
+            nickname_candidates: None,
+        },
+    );
+    set_turn_config(&mut turn, config);
+    turn.session_source = SessionSource::Custom("g4_qualification_parent_test".to_string());
+    let root = manager
+        .start_thread(StartThreadOptions::new((*turn.config).clone()))
+        .await
+        .expect("root thread should start");
+    session.services.agent_control = manager.agent_control();
+    session.thread_id = root.thread_id;
+
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    SpawnAgentHandlerV2::default()
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "spawn_agent",
+            function_payload(json!({
+                "message": "wait for exact close",
+                "task_name": "g4_closed_child",
+                "agent_type": "g4_qualification_probe_worker"
+            })),
+        ))
+        .await
+        .expect("exact G4 child spawn should succeed");
+    let agent_id = session
+        .services
+        .agent_control
+        .resolve_agent_reference(session.thread_id, &turn.session_source, "g4_closed_child")
+        .await
+        .expect("exact G4 child path should resolve");
+
+    let output = CloseAgentHandlerV2
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "close_agent",
+            function_payload(json!({"target": "g4_closed_child"})),
+        ))
+        .await
+        .expect("exact G4 child close should succeed");
+    let (content, success) = expect_text_output(output);
+    let result: CloseAgentResultV2 =
+        serde_json::from_str(&content).expect("close_agent result should be json");
+
+    assert_eq!(result.target_thread_id, agent_id.to_string());
+    assert_eq!(result.target_agent_path, "/root/g4_closed_child");
+    assert!(result.session_loop_terminated);
+    assert!(result.model_callable_process_bootstrap_absent);
+    assert_eq!(result.tracked_background_processes_before_close, Some(0));
+    assert_eq!(
+        result.tracked_process_ids_by_thread,
+        [(agent_id.to_string(), Vec::new())].into_iter().collect()
+    );
+    assert_eq!(
+        result.confirmed_exit_process_ids_by_thread,
+        [(agent_id.to_string(), Vec::new())].into_iter().collect()
+    );
+    assert_eq!(
+        result.unconfirmed_exit_process_ids_by_thread,
+        [(agent_id.to_string(), Vec::new())].into_iter().collect()
+    );
+    assert_eq!(
+        result.unresolved_start_process_ids_by_thread,
+        [(agent_id.to_string(), Vec::new())].into_iter().collect()
+    );
+    assert!(result.tracked_process_termination_confirmed);
+    assert!(result.closed_catalog_actor_quiescence_claimed);
+    assert!(!result.process_tree_quiescence_claimed);
+    assert_eq!(success, Some(true));
+    assert_eq!(
+        session.services.agent_control.get_status(agent_id).await,
+        AgentStatus::NotFound
+    );
+}
