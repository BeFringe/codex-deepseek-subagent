+async fn exact_g4_qualification_parent_has_direct_closed_tool_catalog() {
+    let plan = probe_with(
+        |turn| {
+            set_features(
+                turn,
+                &[
+                    Feature::ShellTool,
+                    Feature::RequestPermissionsTool,
+                    Feature::CodeMode,
+                    Feature::CodeModeOnly,
+                    Feature::MultiAgentV2,
+                    Feature::ToolSuggest,
+                    Feature::Apps,
+                    Feature::Plugins,
+                    Feature::StandaloneWebSearch,
+                ],
+            );
+            set_web_search_mode(turn, WebSearchMode::Live);
+            update_turn_settings_for_test(turn, |settings| {
+                Arc::make_mut(&mut settings.model_info).apply_patch_tool_type =
+                    Some(ApplyPatchToolType::Freeform);
+            });
+            update_config(turn, |config| {
+                config.multi_agent_v2.tool_namespace = Some("g4_assignment".to_string());
+                config.multi_agent_v2.non_code_mode_only = true;
+            });
+            turn.session_source = SessionSource::Custom("g4_qualification_parent_test".to_string());
+        },
+        ToolPlanInputs {
+            tool_runtimes: vec![mcp_runtime(
+                "g4_probe_server",
+                "mcp__g4_probe",
+                "lookup",
+                ToolExposure::Direct,
+            )],
+            extension_tool_executors: vec![Arc::new(TestNamespaceExtensionTool {
+                namespace: "g4_extension",
+                tool_name: "lookup",
+            })],
+            dynamic_tools: vec![dynamic_tool(
+                Some("g4_dynamic"),
+                "lookup",
+                /*defer_loading*/ false,
+            )],
+            tool_suggest_candidates: Some(plugin_candidates(ToolSuggestPresentation::ListTool)),
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await;
+
+    assert_eq!(plan.tool_mode, ToolMode::Direct);
+    assert!(!plan.requires_code_mode_worker);
+    assert!(plan.code_mode_tool_names.is_empty());
+    assert!(plan.can_manage_children);
+    plan.assert_visible_contains(&["apply_patch", "g4_assignment"]);
+    for tool_name in [
+        "spawn_agent",
