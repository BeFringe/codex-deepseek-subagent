+++ b/codex-rs/core/src/tools/handlers/multi_agents_v2/close_agent.rs
@@ -0,0 +1,215 @@
+use super::analytics::ToolCallAnalytics;
+use super::*;
+use crate::tools::handlers::multi_agents_spec::create_close_agent_tool_v2;
+use codex_protocol::protocol::SessionSource;
+use codex_tools::ToolSpec;
+
+const G4_PARENT_CHILD_CATALOG_RECEIPT_ENV: &str = "CODEX_G4_TOOL_CATALOG_RECEIPT";
+const G4_PARENT_CHILD_CATALOG_RECEIPT_OPT_IN: &str = "stderr-v2-parent-child-closed";
+const G4_QUALIFICATION_PROBE_ROLE: &str = "g4_qualification_probe_worker";
+
+pub(crate) struct Handler;
+
+impl ToolExecutor<ToolInvocation> for Handler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("close_agent")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_close_agent_tool_v2()
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let mut analytics = ToolCallAnalytics::new(&invocation, CollabAgentTool::CloseAgent);
+            let result = handle_close_agent(invocation, &mut analytics).await;
+            analytics.finish(&result);
+            result.map(boxed_tool_output)
+        })
+    }
+}
+
+async fn handle_close_agent(
+    invocation: ToolInvocation,
+    analytics: &mut ToolCallAnalytics,
+) -> Result<CloseAgentResult, FunctionCallError> {
+    let ToolInvocation {
+        session,
+        turn,
+        payload,
+        call_id,
+        ..
+    } = invocation;
+    let arguments = function_arguments(payload)?;
+    let args: CloseAgentArgs = parse_arguments(&arguments)?;
+    let agent_id = resolve_agent_target(&session, &turn, &args.target).await?;
+    analytics.set_receiver(agent_id);
+    let receiver_agent = session
+        .services
+        .agent_control
+        .ensure_agent_known(agent_id)
+        .map_err(|err| collab_agent_error(agent_id, err))?;
+    if receiver_agent
+        .agent_path
+        .as_ref()
+        .is_some_and(AgentPath::is_root)
+    {
+        return Err(FunctionCallError::RespondToModel(
+            "root is not a spawned agent".to_string(),
+        ));
+    }
+    if agent_id == session.thread_id {
+        return Err(FunctionCallError::RespondToModel(
+            "an agent cannot close itself; return your result and let the parent close you if needed"
+                .to_string(),
+        ));
+    }
+    let receiver_agent_path = receiver_agent.agent_path.clone().ok_or_else(|| {
+        FunctionCallError::RespondToModel("target agent is missing an agent_path".to_string())
+    })?;
+    let closed_catalog_scope = exact_g4_parent_child_closed_catalog_scope(
+        &turn.session_source,
+        receiver_agent.agent_role.as_deref(),
+    );
+    let status = session.services.agent_control.get_status(agent_id).await;
+    let termination = Box::pin(
+        session
+            .services
+            .agent_control
+            .close_agent_with_termination_receipt(agent_id),
+    )
+    .await
+    .map_err(|err| collab_agent_error(agent_id, err))?;
+    let session_loop_terminated = termination
+        .sessions
+        .iter()
+        .all(|receipt| receipt.session_loop_terminated);
+    let process_reports_complete = termination
+        .sessions
+        .iter()
+        .all(|receipt| receipt.process_report.is_some());
+    let mut tracked_process_ids_by_thread = std::collections::BTreeMap::new();
+    let mut confirmed_exit_process_ids_by_thread = std::collections::BTreeMap::new();
+    let mut unconfirmed_exit_process_ids_by_thread = std::collections::BTreeMap::new();
+    let mut unresolved_start_process_ids_by_thread = std::collections::BTreeMap::new();
+    for receipt in &termination.sessions {
+        let Some(report) = &receipt.process_report else {
+            continue;
+        };
+        let thread_id = receipt.thread_id.to_string();
+        tracked_process_ids_by_thread.insert(thread_id.clone(), report.tracked_process_ids.clone());
+        confirmed_exit_process_ids_by_thread
+            .insert(thread_id.clone(), report.confirmed_exit_process_ids.clone());
+        unconfirmed_exit_process_ids_by_thread.insert(
+            thread_id.clone(),
+            report.unconfirmed_exit_process_ids.clone(),
+        );
+        unresolved_start_process_ids_by_thread
+            .insert(thread_id, report.unresolved_start_process_ids.clone());
+    }
+    let tracked_process_termination_confirmed = process_reports_complete
+        && termination.sessions.iter().all(|receipt| {
+            receipt.process_report.as_ref().is_some_and(|report| {
+                report.unconfirmed_exit_process_ids.is_empty()
+                    && report.unresolved_start_process_ids.is_empty()
+                    && report.tracked_process_ids == report.confirmed_exit_process_ids
+            })
+        });
+    let tracked_background_processes_before_close =
+        closed_catalog_scope.then_some(tracked_process_ids_by_thread.values().map(Vec::len).sum());
+    emit_sub_agent_activity(
+        &session,
+        &turn,
+        SubAgentActivityItem {
+            id: call_id,
+            agent_thread_id: agent_id,
+            agent_path: receiver_agent_path.clone(),
+            kind: SubAgentActivityKind::Completed,
+        },
+    )
+    .await;
+
+    Ok(CloseAgentResult {
+        previous_status: status,
+        target_thread_id: agent_id.to_string(),
+        target_agent_path: receiver_agent_path.to_string(),
+        session_loop_terminated,
+        model_callable_process_bootstrap_absent: closed_catalog_scope,
+        tracked_background_processes_before_close,
+        tracked_process_ids_by_thread,
+        confirmed_exit_process_ids_by_thread,
+        unconfirmed_exit_process_ids_by_thread,
+        unresolved_start_process_ids_by_thread,
+        tracked_process_termination_confirmed,
+        closed_catalog_actor_quiescence_claimed: closed_catalog_scope
+            && session_loop_terminated
+            && tracked_process_termination_confirmed
+            && tracked_background_processes_before_close == Some(0),
+        process_tree_quiescence_claimed: false,
+    })
+}
+
+fn exact_g4_parent_child_closed_catalog_scope(
+    session_source: &SessionSource,
+    receiver_agent_role: Option<&str>,
+) -> bool {
+    let exact_parent = (cfg!(test)
+        && matches!(
+            session_source,
+            SessionSource::Custom(source) if source == "g4_qualification_parent_test"
+        ))
+        || (matches!(session_source, SessionSource::Exec)
+            && std::env::var(G4_PARENT_CHILD_CATALOG_RECEIPT_ENV).as_deref()
+                == Ok(G4_PARENT_CHILD_CATALOG_RECEIPT_OPT_IN));
+    exact_parent && receiver_agent_role == Some(G4_QUALIFICATION_PROBE_ROLE)
+}
+
+impl CoreToolRuntime for Handler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Function { .. })
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CloseAgentArgs {
+    target: String,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+pub(crate) struct CloseAgentResult {
+    pub(crate) previous_status: AgentStatus,
+    pub(crate) target_thread_id: String,
+    pub(crate) target_agent_path: String,
+    pub(crate) session_loop_terminated: bool,
+    pub(crate) model_callable_process_bootstrap_absent: bool,
+    pub(crate) tracked_background_processes_before_close: Option<usize>,
+    pub(crate) tracked_process_ids_by_thread: std::collections::BTreeMap<String, Vec<i32>>,
+    pub(crate) confirmed_exit_process_ids_by_thread: std::collections::BTreeMap<String, Vec<i32>>,
+    pub(crate) unconfirmed_exit_process_ids_by_thread: std::collections::BTreeMap<String, Vec<i32>>,
+    pub(crate) unresolved_start_process_ids_by_thread: std::collections::BTreeMap<String, Vec<i32>>,
+    pub(crate) tracked_process_termination_confirmed: bool,
+    pub(crate) closed_catalog_actor_quiescence_claimed: bool,
+    pub(crate) process_tree_quiescence_claimed: bool,
+}
+
+impl ToolOutput for CloseAgentResult {
+    fn log_output(&self) -> String {
+        tool_output_json_text(self, "close_agent")
+    }
+
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        tool_output_response_item(call_id, payload, self, Some(true), "close_agent")
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> JsonValue {
+        tool_output_code_mode_result(self, "close_agent")
+    }
+}
