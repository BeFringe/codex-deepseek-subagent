@@ -0,0 +1,97 @@
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::tools::router::ToolRouter;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+use serde_json::json;
+
+const G4_CATALOG_RECEIPT_ENV: &str = "CODEX_G4_TOOL_CATALOG_RECEIPT";
+const G4_CATALOG_RECEIPT_OPT_IN: &str = "stderr-v1";
+const G4_PARENT_CHILD_CATALOG_RECEIPT_OPT_IN: &str = "stderr-v2-parent-child-closed";
+const G4_CATALOG_RECEIPT_PREFIX: &str = "G4_TOOL_CATALOG_RECEIPT_V1 ";
+const G4_PARENT_CHILD_CATALOG_RECEIPT_PREFIX: &str = "G4_TOOL_CATALOG_RECEIPT_V2 ";
+const G4_QUALIFICATION_PROBE_ROLE: &str = "g4_qualification_probe_worker";
+
+/// Emits an opt-in, credential-free receipt from the finalized router used by a real child step.
+///
+/// This qualification-only seam writes one compact line to stderr. It does not mutate the
+/// workspace or Codex state, and it remains silent for roots and for every non-G4 role.
+pub(crate) fn emit_if_requested(
+    session: &Session,
+    turn_context: &TurnContext,
+    router: &ToolRouter,
+) {
+    if turn_context.sub_id.is_empty() {
+        return;
+    }
+    match std::env::var(G4_CATALOG_RECEIPT_ENV).as_deref() {
+        Ok(G4_CATALOG_RECEIPT_OPT_IN) => {
+            let SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id,
+                depth,
+                agent_path: Some(agent_path),
+                agent_role: Some(agent_role),
+                ..
+            }) = &turn_context.session_source
+            else {
+                return;
+            };
+            if agent_role != G4_QUALIFICATION_PROBE_ROLE {
+                return;
+            }
+            let receipt = json!({
+                "schema": 1,
+                "event": "finalized_tool_catalog",
+                "source": "headless_candidate_runtime",
+                "session_id": session.session_id().to_string(),
+                "child_thread_id": session.thread_id().to_string(),
+                "turn_id": turn_context.sub_id.as_str(),
+                "parent_thread_id": parent_thread_id.to_string(),
+                "depth": depth,
+                "agent_path": agent_path.as_str(),
+                "agent_role": agent_role,
+                "catalog": router.qualification_catalog_receipt(),
+            });
+            eprintln!("{G4_CATALOG_RECEIPT_PREFIX}{receipt}");
+        }
+        Ok(G4_PARENT_CHILD_CATALOG_RECEIPT_OPT_IN) => {
+            let receipt = match &turn_context.session_source {
+                SessionSource::Exec => json!({
+                    "schema": 2,
+                    "event": "finalized_tool_catalog",
+                    "source": "headless_candidate_runtime",
+                    "actor_kind": "qualification_parent",
+                    "session_id": session.session_id().to_string(),
+                    "thread_id": session.thread_id().to_string(),
+                    "turn_id": turn_context.sub_id.as_str(),
+                    "agent_path": "/root",
+                    "agent_role": "root",
+                    "catalog": router.qualification_catalog_receipt(),
+                }),
+                SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id,
+                    depth,
+                    agent_path: Some(agent_path),
+                    agent_role: Some(agent_role),
+                    ..
+                }) if agent_role == G4_QUALIFICATION_PROBE_ROLE => json!({
+                    "schema": 2,
+                    "event": "finalized_tool_catalog",
+                    "source": "headless_candidate_runtime",
+                    "actor_kind": "qualification_child",
+                    "session_id": session.session_id().to_string(),
+                    "thread_id": session.thread_id().to_string(),
+                    "turn_id": turn_context.sub_id.as_str(),
+                    "parent_thread_id": parent_thread_id.to_string(),
+                    "depth": depth,
+                    "agent_path": agent_path.as_str(),
+                    "agent_role": agent_role,
+                    "catalog": router.qualification_catalog_receipt(),
+                }),
+                _ => return,
+            };
+            eprintln!("{G4_PARENT_CHILD_CATALOG_RECEIPT_PREFIX}{receipt}");
+        }
+        _ => {}
+    }
+}
