+#[test]
+fn direct_source_only_treats_configured_multi_agent_namespace_as_plaintext() {
+    let call = ToolCall {
+        tool_name: ToolName::namespaced("g4_assignment", "spawn_agent"),
+        call_id: "call-custom-multi-agent".to_string(),
+        payload: ToolPayload::Function {
+            arguments: r#"{"message":"bounded task"}"#.to_string(),
+        },
+        encrypted_function_args: Some(Vec::new()),
+    };
+
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("g4_assignment"), false),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("collaboration"), false),
+        ToolCallSource::Direct
+    );
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(None, false),
+        ToolCallSource::Direct
+    );
+}
+
+#[test]
+fn configured_plaintext_delivery_handles_absent_server_encryption_marker() {
+    let mut call = ToolCall {
+        tool_name: ToolName::namespaced("g4_assignment", "spawn_agent"),
+        call_id: "call-live-custom-multi-agent".to_string(),
+        payload: ToolPayload::Function {
+            arguments: r#"{"message":"bounded task"}"#.to_string(),
+        },
+        encrypted_function_args: None,
+    };
+
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("g4_assignment"), true),
+        ToolCallSource::DirectPlaintextMessage
+    );
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("g4_assignment"), false),
+        ToolCallSource::Direct
+    );
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("collaboration"), true),
+        ToolCallSource::Direct
+    );
+
+    call.encrypted_function_args = Some(vec!["message".to_string()]);
+    assert_eq!(
+        call.direct_source_for_multi_agent_namespace(Some("g4_assignment"), true),
+        ToolCallSource::Direct
+    );
+}
